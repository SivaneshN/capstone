# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit your real API key.

aws_region   = "us-east-1"
project_name = "apod-archive"
environment  = "capstone"

# Get a free key instantly at https://api.nasa.gov
nasa_api_key = "YOUR_NASA_API_KEY_HERE"

# If you're in an AWS Academy / Learner Lab account and terraform apply fails
# with "not authorized to perform: iam:CreateRole", uncomment this and set it
# to your LabRole ARN (find it with:
#   aws iam get-role --role-name LabRole --query 'Role.Arn' --output text
# ):
# lab_role_arn = "arn:aws:iam::123456789012:role/LabRole"

# Optional overrides (defaults shown)
# schedule_cron             = "cron(0 8 * * ? *)"
# tag_confidence_threshold  = 0.85
# max_tags                  = 10
# log_retention_days        = 14
